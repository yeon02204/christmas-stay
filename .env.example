# 이 파일을 복사해서 .env.local 로 만들고 값을 채워 줘. (.env.local 은 git 에 올라가지 않아)
# Supabase 대시보드 > Project Settings > API Keys 에서 확인

# 프로젝트 URL (예: https://abcdefghijkl.supabase.co)
VITE_SUPABASE_URL=

# Publishable key (sb_publishable_... 로 시작). 예전 프로젝트라면 anon key 를 넣어도 돼.
# ⚠️ secret / service_role 키는 절대 넣지 마. 브라우저에 그대로 노출돼.
VITE_SUPABASE_PUBLISHABLE_KEY=
